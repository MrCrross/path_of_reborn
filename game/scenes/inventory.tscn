[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/inventory_screen.gd" id="1_inventory"]

[node name="Inventory" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_inventory")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.075, 0.105, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "ИНВЕНТАРЬ"
horizontal_alignment = 1

[node name="StatsText" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_font_sizes/font_size = 10
horizontal_alignment = 1

[node name="UpgradeRow" type="HBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="StrengthUpgrade" type="Button" parent="Margin/Column/UpgradeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 10
text = "Сила +1"

[node name="HpUpgrade" type="Button" parent="Margin/Column/UpgradeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 10
text = "HP +4"

[node name="TypeFilter" type="OptionButton" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_font_sizes/font_size = 10

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="ItemsList" type="VBoxContainer" parent="Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="BackButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Назад к пути"

[connection signal="pressed" from="Margin/Column/UpgradeRow/StrengthUpgrade" to="." method="_on_strength_upgrade_pressed"]
[connection signal="pressed" from="Margin/Column/UpgradeRow/HpUpgrade" to="." method="_on_hp_upgrade_pressed"]
[connection signal="item_selected" from="Margin/Column/TypeFilter" to="." method="_on_filter_selected"]
[connection signal="pressed" from="Margin/Column/BackButton" to="." method="_on_back_pressed"]
