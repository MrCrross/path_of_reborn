[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world.gd" id="1_world"]

[node name="World" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_world")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.14, 0.12, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 10.0
offset_right = -12.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Heading" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "ГРАНИЦА ЛЕСА"
horizontal_alignment = 1

[node name="StatusText" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 11
autowrap_mode = 3
vertical_alignment = 1

[node name="SlimeButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "1. Слизь"

[node name="GoblinButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "2. Гоблин"

[node name="InventoryButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Инвентарь · I"

[node name="CheckpointButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Печать Пути · C"

[node name="RestButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Отдохнуть в Лиорене"
visible = false

[node name="Hint" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "Бой: Space — атака · E — уклонение"
autowrap_mode = 3

[connection signal="pressed" from="Margin/Column/SlimeButton" to="." method="_on_slime_pressed"]
[connection signal="pressed" from="Margin/Column/GoblinButton" to="." method="_on_goblin_pressed"]
[connection signal="pressed" from="Margin/Column/InventoryButton" to="." method="_on_inventory_pressed"]
[connection signal="pressed" from="Margin/Column/CheckpointButton" to="." method="_on_checkpoint_pressed"]
