[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/title.gd" id="1_title"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.055, 0.09, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14.0
offset_top = 18.0
offset_right = -14.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 9

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "PATH OF REBORN"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Subtitle" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "Homecoming: The Journey of an Isekai Hero"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Spacer" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_vertical = 3

[node name="ContinueButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Продолжить"
visible = false

[node name="BeginButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "Начать путь"

[node name="ConfirmRow" type="HBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 5
visible = false

[node name="ConfirmButton" type="Button" parent="Margin/Column/ConfirmRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 10
text = "Да, заново"

[node name="CancelButton" type="Button" parent="Margin/Column/ConfirmRow"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 10
text = "Отмена"

[node name="StatusText" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="Margin/Column/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="Margin/Column/BeginButton" to="." method="_on_begin_pressed"]
[connection signal="pressed" from="Margin/Column/ConfirmRow/ConfirmButton" to="." method="_on_confirm_pressed"]
[connection signal="pressed" from="Margin/Column/ConfirmRow/CancelButton" to="." method="_on_cancel_pressed"]
