[node name="HelpButton" type="Button" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2

[node name="HelpText" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 9
text = "Фиксация: 5 с неподвижно, вне боя. До 3 точек. Возврат расходует точку и более поздние снимки. Без точек: +2 Следа и потеря незакреплённых Кристаллов Эха. Три Следа ведут в Лиорен; отдых снимает их."

[node name="BlockLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
