class_name ArtMap
extends RefCounted

## Единый явный каталог отображения «семантика -> ассет».
## Источник истины: assets/manifest.json (только status: approved).
## Копии PNG живут в game/art/ (см. tools/copy_art.py, SHA-256 сверен с манифестом).

const ROOT := "res://art/"
static var _animation_catalog: Dictionary = {}


## Native-resolution atlas registration, generated by tools/copy_art.py from
## approved manifest entries. Legacy catalog-only clips keep their old contract.
static func animation_spec(sheet: Dictionary) -> Dictionary:
	if _animation_catalog.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(ROOT + "animation_catalog.json"))
		if parsed is Dictionary:
			_animation_catalog = parsed
	var raw: Dictionary = _animation_catalog.get(sheet["path"], {})
	var spec: Dictionary = sheet.duplicate()
	if raw.is_empty():
		return spec
	spec["frame"] = Vector2i(int(raw["frame"][0]), int(raw["frame"][1]))
	spec["offset"] = Vector2(float(raw["offset"][0]), float(raw["offset"][1]))
	spec["scale"] = float(raw["scale"])
	spec["count"] = int(raw["count"])
	spec["regions"] = raw["regions"]
	return spec


static func apply_animation_transform(sprite: AnimatedSprite2D, sheet: Dictionary, centered_canvas: bool = false) -> void:
	var spec: Dictionary = animation_spec(sheet)
	sprite.scale = Vector2.ONE * float(spec.get("scale", 1.0))
	sprite.offset = spec.get("offset", Vector2.ZERO)
	if centered_canvas:
		# Prologue actors historically used a centered 96x128 canvas, not a foot pivot.
		sprite.offset -= Vector2(sheet.get("offset", Vector2.ZERO)) / sprite.scale

