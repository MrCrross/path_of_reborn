static func texture(relative_path: String) -> Texture2D:
	return load(ROOT + relative_path)


## Собирает SpriteFrames из trimmed native atlas + virtual margins.
## Старые, пока не используемые клипы поддерживают горизонтальную полосу.
static func sprite_frames(sheet: Dictionary, fps: float = 8.0, one_shot: bool = false) -> SpriteFrames:
	sheet = animation_spec(sheet)
	var frames := SpriteFrames.new()
	frames.remove_animation(&"default")
	var atlas: Texture2D = load(ROOT + sheet["path"])
	var frame_size: Vector2i = sheet["frame"]
	var count: int = sheet["count"]
	frames.add_animation(&"default")
	frames.set_animation_speed(&"default", fps)
	frames.set_animation_loop(&"default", not one_shot)
	for index: int in range(count):
		var region := AtlasTexture.new()
		region.atlas = atlas
		region.filter_clip = true
		if sheet.has("regions"):
			var entry: Dictionary = sheet["regions"][index]
			var rect: Array = entry["region"]
			var margin: Array = entry["margin"]
			region.region = Rect2(rect[0], rect[1], rect[2], rect[3])
			region.margin = Rect2(margin[0], margin[1], margin[2], margin[3])
		else:
			region.region = Rect2(index * frame_size.x, 0, frame_size.x, frame_size.y)
		frames.add_frame(&"default", region)
	return frames


## Иконка предмета; null, когда утверждённой иконки нет (карточка без иконки).
static func item_icon(item_id: String, aspect_id: String = "") -> Texture2D:
	var entry: Variant = ITEM_ICONS.get(item_id, null)
	if entry == null:
		return null
	if entry is Dictionary:
		return texture((entry as Dictionary).get(aspect_id, (entry as Dictionary).get("", "")))
	return texture(entry)
